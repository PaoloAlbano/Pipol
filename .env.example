# Copy this file to .env to override defaults.
# Never commit .env to version control.

# WebSocket URL of your @hyperswarm/dht-relay node.
# VITE_DHT_RELAY_URL=wss://relay.yourdomain.com

# Optional: HTTPS endpoint returning { "iceServers": [...] } with TURN credentials.
# Defaults to <relay>/ice (see README, "TURN server").
# VITE_ICE_URL=https://relay.yourdomain.com/ice

# Optional: Cloudflare Turnstile site key. Set it when the relay requires a Turnstile token for /ice
# (relay variable TURNSTILE_SECRET). The widget is invisible unless Cloudflare needs an interaction.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Optional kill switch: when "true" the app never uses a TURN server of its own or its workspaces'
# (public STUN only). Users can still choose "Custom" servers in Settings.
# VITE_TURN_DISABLED=true

# ── Docker (see docs/docker.md) ──────────────────────────────────────────────────────────────────────────
# The web container builds the app when it starts, from the addresses the BROWSER must use for the relay and
# the auth server; pass them with -e (the VITE_* variables above also apply):
#   VITE_DHT_RELAY_URL=ws://localhost:8787     on a server: wss://relay.example.com
#   VITE_AUTH_URL=http://localhost:8081        on a server: https://auth.example.com (empty: no sign-in providers)
# The relay and the auth server take their own variables (docs/relay.md) with -e or --env-file. Give each
# container only its own: a file with every secret should not go to all three.
#
# Relay: number of proxies in front of it. The image default is 1; when browsers connect directly use 0.
# TRUST_PROXY_HOPS=0
# Relay: one line every N seconds with connections, rooms and memory:
# RELAY_STATS_INTERVAL_SEC=10
# Auth server (make auth-gen-key prints the master key; keep it, losing it changes the derived identities).
# ALLOWED_ORIGINS: the address of the app; unset, any website may call the auth server.
# ALLOWED_ORIGINS=http://localhost:8080
# PIPOL_MASTER_KEY_V1=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

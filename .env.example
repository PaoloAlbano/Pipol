# Copy this file to .env to override defaults.
# Never commit .env to version control.

# WebSocket URL of your @hyperswarm/dht-relay node.
# VITE_DHT_RELAY_URL=wss://relay.yourdomain.com

# Optional: HTTPS endpoint returning { "iceServers": [...] } with TURN credentials.
# Defaults to <relay>/ice (see README, "TURN server").
# VITE_ICE_URL=https://relay.yourdomain.com/ice

# Optional: Cloudflare Turnstile site key. Set it when the relay requires a Turnstile token for /ice
# (relay variable TURNSTILE_SECRET). The widget is invisible unless Cloudflare needs an interaction.
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Optional kill switch: when "true" the app never uses a TURN server of its own or its workspaces'
# (public STUN only). Users can still choose "Custom" servers in Settings.
# VITE_TURN_DISABLED=true

# ── Docker (docker compose up --build, see docs/docker.md) ───────────────────────────────────────────────
# The VITE_* variables above also apply (they are fixed when the web image is built).
# Anything of the relay (docs/relay.md) can go here too: ICE_ALLOWED_ORIGINS, TURN_*, CLOUDFLARE_*, ...
#
# WEB_PORT=8080
# Resource limits for the relay, to reproduce a small hosting plan:
# RELAY_CPUS=0.5
# RELAY_MEMORY=512m
# One line every N seconds with connections, rooms and memory of the relay:
# RELAY_STATS_INTERVAL_SEC=10
# Auth server (make auth-gen-key prints the master key; keep it, losing it changes the derived identities):
# PIPOL_MASTER_KEY_V1=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

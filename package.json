{
  "name": "pipol",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.5.0",
  "description": "Fully P2P group chat and video chat PWA.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --print-width 120 --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,jsx}\"",
    "format:check": "prettier --print-width 120 --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,jsx}\"",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:update": "playwright test --update-snapshots=all"
  },
  "dependencies": {
    "@hyperswarm/dht-relay": "^0.4.3",
    "b4a": "^1.8.1",
    "compact-encoding": "^2.19.0",
    "corestore": "^6.18.4",
    "dompurify": "^3.4.11",
    "hyperbeam": "^3.1.0",
    "hyperbee": "^2.27.3",
    "hypercore": "^10.38.2",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.0",
    "marked": "^17.0.5",
    "protomux": "^3.11.0",
    "random-access-memory": "^6.2.1",
    "random-access-web": "^2.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sodium-javascript": "^0.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "vite": "^6.4.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^4.1.9"
  }
}
